# Copy this file to .env and fill in the value. Never commit .env.
# The agent's restricted function-call key (it can only call `pay` on the vault).
# It is the private_key value in the key file saved under
# ~/.near-credentials/testnet/<agent account>/ when you add the key.
AGENT_PRIVATE_KEY=ed25519:REPLACE_WITH_THE_AGENTS_RESTRICTED_PRIVATE_KEY

# Optional overrides (the defaults point to the author's testnet deployment):
# VAULT_ID=vault.your-owner.testnet
# AGENT_ID=agent.your-owner.testnet
# VENDOR_ID=vendor.your-owner.testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com
